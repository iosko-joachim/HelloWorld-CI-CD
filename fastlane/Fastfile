# X-004 Fastlane (projekt/extern/X-004.md), aufgerufen aus C-001 (.github/workflows/ci-cd.yml).
# Geheimes kommt aus GitHub Actions Secrets (RISK-003), nicht Geheimes aus
# fastlane/.env.default.

APP_ID = "com.iosko.helloworldcicd"

def need(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} fehlt – Secret bei GitHub oder Eintrag in fastlane/.env.default") if value.empty?
  value
end

# Store-Build-Nummer = Lauf-Nummer der Pipeline (daten.md, Frage 5).
def build_number
  need("GITHUB_RUN_NUMBER")
end

platform :android do
  # I-002 Android-Einreichung an X-002 (Google Play Console)
  lane :deploy do
    aab = Dir["../androidApp/build/outputs/bundle/release/*.aab"].first
    UI.user_error!("Kein AAB gefunden – lief build-test?") unless aab

    upload_to_play_store(
      package_name: APP_ID,
      aab: File.expand_path(aab),
      json_key_data: need("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"),
      track: "internal", # ADR-003, NG-004
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  # I-003 iOS-Einreichung an X-003 (Apple App Store Connect)
  lane :deploy do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: need("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: need("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: need("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: APP_ID,
      api_key: api_key,
      readonly: true
    )

    update_code_signing_settings(
      path: "iosApp/iosApp.xcodeproj",
      use_automatic_signing: false,
      team_id: need("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: need("sigh_#{APP_ID}_appstore_profile-name")
    )

    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "TEAM_ID=#{need('APPLE_TEAM_ID')} CURRENT_PROJECT_VERSION=#{build_number}"
    )

    # ADR-003, NG-004: nur TestFlight für interne Tester, keine App-Store-Prüfung.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
