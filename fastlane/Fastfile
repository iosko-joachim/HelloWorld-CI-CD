# X-004 Fastlane (projekt/extern/X-004.md), aufgerufen aus C-001 (.github/workflows/ci-cd.yml).
# Geheimes kommt aus GitHub Actions Secrets (RISK-003), nicht Geheimes aus
# fastlane/.env.default.

require "base64"
require "tmpdir"

APP_ID = "com.iosko.helloworldcicd"

def need(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} fehlt – Secret bei GitHub oder Eintrag in fastlane/.env.default") if value.empty?
  value
end

# Store-Build-Nummer = Lauf-Nummer der Pipeline (daten.md, Frage 5).
def build_number
  need("GITHUB_RUN_NUMBER")
end

platform :android do
  # I-002 Android-Einreichung an X-002 (Google Play Console)
  lane :deploy do
    aab = Dir["../androidApp/build/outputs/bundle/release/*.aab"].first
    UI.user_error!("Kein AAB gefunden – lief build-test?") unless aab

    upload_to_play_store(
      package_name: APP_ID,
      aab: File.expand_path(aab),
      json_key_data: need("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"),
      track: "internal", # ADR-003, NG-004
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  # I-003 iOS-Einreichung an X-003 (Apple App Store Connect)
  lane :deploy do
    setup_ci

    team = need("APPLE_TEAM_ID")
    key_id = need("APP_STORE_CONNECT_API_KEY_ID")
    issuer_id = need("APP_STORE_CONNECT_API_ISSUER_ID")
    key_content = need("APP_STORE_CONNECT_API_KEY_CONTENT")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true
    )

    # ADR-005: Xcode holt Zertifikat und Profil selbst bei Apple (Cloud-Signing),
    # angemeldet über den API-Schlüssel statt über eine Apple-ID.
    key_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    File.binwrite(key_path, Base64.decode64(key_content))
    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{issuer_id}"

    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team,
      export_options: { signingStyle: "automatic", teamID: team },
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{team} CODE_SIGN_STYLE=Automatic " \
              "CODE_SIGN_IDENTITY='Apple Distribution' CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: auth
    )

    # ADR-003, NG-004: nur TestFlight für interne Tester, keine App-Store-Prüfung.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
